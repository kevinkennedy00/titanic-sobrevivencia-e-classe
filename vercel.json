{
  "builds": [
    {
      "src": "app/web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://titanic-presentation-api-xrhxn6whyq-rj.a.run.app/api/$1" },
    { "source": "/team/(.*)", "destination": "https://titanic-presentation-api-xrhxn6whyq-rj.a.run.app/team/$1" },
    { "source": "/assets/(.*)", "destination": "/app/web/assets/$1" },
    { "source": "/design-system/(.*)", "destination": "/app/web/design-system/$1" },
    { "source": "/", "destination": "/app/web/index.html" },
    { "source": "/(.*)", "destination": "/app/web/index.html" }
  ]
}
